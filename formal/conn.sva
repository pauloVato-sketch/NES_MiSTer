\assert__conn:c_0 : assert property (@(posedge FPGA_CLK1_50) 
 (emu___CLK_VIDEO == emu___video_freak___CLK_VIDEO)
);

\assert__conn:c_1 : assert property (@(posedge FPGA_CLK1_50) 
 (emu___CLK_VIDEO == emu___video_mixer___CLK_VIDEO)
);

