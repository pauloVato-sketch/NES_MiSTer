 (emu___HDMI_FREEZE == emu___video_mixer___HDMI_FREEZE)
);

\assert__conn:c_7 : assert property (@(posedge FPGA_CLK1_50) 
 (((~led_overtake[0])) != 1'b0 && ((led_overtake[0] & led_state[0])) == 1'b0) |-> (emu___LED_USER == LED[0])
);

\assert__conn:c_8 : assert property (@(posedge FPGA_CLK1_50) 
 ((gp_out[29]) == 1'b0 && ! (1'b0) && ((~led_overtake[2])) != 1'b0 && ((led_overtake[2] & led_state[2])) == 1'b0) |-> (emu___LED_DISK[0] == LED[2])
);

\assert__conn:c_9 : assert property (@(posedge FPGA_CLK1_50) 
 (! ((mcp_en || (SDCD_SPDIF && (~SW[2])))) && (~av_dis)) |-> (emu___SD_SCK == SDIO_CLK)
);

\assert__conn:c_10 : assert property (@(posedge FPGA_CLK1_50) 
 ((~((~mcp_en) || mcp_sdcd))) |-> (emu___SD_SCK == SD_SPI_CLK)
);

\assert__conn:c_11 : assert property (@(posedge FPGA_CLK1_50) 
 ((~((~mcp_en) || mcp_sdcd))) |-> (emu___SD_MOSI == SD_SPI_MOSI)
);

\assert__conn:c_12 : assert property (@(posedge FPGA_CLK1_50) 
 (mcp_en && (mcp_en ? (~mcp_sdcd) : ((sog && (~cs1)) && (~VGA_EN)))) |-> (emu___SD_CS == SD_SPI_CS)
);

\assert__conn:c_13 : assert property (@(posedge FPGA_CLK1_50) 
 (emu___SDRAM_CLK == SDRAM_CLK)
);

\assert__conn:c_14 : assert property (@(posedge FPGA_CLK1_50) 
