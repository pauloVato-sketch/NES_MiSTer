\assert__conn:c_32 : assert property (@(posedge FPGA_CLK1_50) 
 ((SDIO_DAT[0]) == 1'b0 && ! (mcp_en) && (SD_CD) == 1'b0) |-> (VGA_EN == emu___SD_MISO)
);

\assert__conn:c_33 : assert property (@(posedge FPGA_CLK1_50) 
 ((VGA_EN) == 1'b0 && ! (mcp_en) && (SD_CD) == 1'b0) |-> (SDIO_DAT[0] == emu___SD_MISO)
);

\assert__conn:c_34 : assert property (@(posedge FPGA_CLK1_50) 
 (mcp_en && (SD_CD) == 1'b0) |-> (SD_SPI_MISO == emu___SD_MISO)
);

\assert__conn:c_35 : assert property (@(posedge FPGA_CLK1_50) 
 (! (mcp_en)) |-> (SDCD_SPDIF == emu___SD_CD)
);

\assert__conn:c_36 : assert property (@(posedge FPGA_CLK1_50) 
 (! (mcp_en) && ((mcp_en ? SD_SPI_MISO : (VGA_EN || SDIO_DAT[0]))) == 1'b0) |-> (SDCD_SPDIF == emu___SD_MISO)
);

\assert__conn:c_37 : assert property (@(posedge FPGA_CLK1_50) 
 ((USER_IO[2]) == 1'b0) |-> (SW[1] == emu___USER_IN[2])
